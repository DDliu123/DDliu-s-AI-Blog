    {
      "id": "wVpVNLqUkaztAWi5inqrQ",
      "type": "text",
      "x": -1383.7657161884688,
      "y": -4730.764515580207,
      "width": 586.4134149878852,
      "height": 280.5944768414455,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
