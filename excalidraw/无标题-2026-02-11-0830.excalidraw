    },
    {
      "id": "sYGeQpFlo-cqJZ_w9m3dN",
      "type": "text",
      "x": 642.0855130310715,
      "y": 382.00276846944007,
      "width": 544.4199829101562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1T",
      "roundness": null,
      "seed": 1892628447,
      "version": 141,
      "versionNonce": 558654015,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783756898320,
      "link": null,
      "locked": false,
      "text": "提供服务：教用户如何用AI赚钱，帮助自己解决实际业务问题",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "提供服务：教用户如何用AI赚钱，帮助自己解决实际业务问题",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OnQdEHrURNTS-N-CsVj8N",
      "type": "text",
      "x": 645.6408050595165,
      "y": 430.76273242750347,
      "width": 636,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
