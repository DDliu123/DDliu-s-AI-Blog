    {
      "id": "eojtgCN0g0bXTRQMDOGlA",
      "type": "text",
      "x": -693.7340118263924,
      "y": -5188.294004154202,
      "width": 384,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
